+static bool ghostlock_write_full(int fd, const void *buffer, size_t length) {
+  const unsigned char *cursor = buffer;
+  while (length != 0) {
+    ssize_t count = write(fd, cursor, length);
+    if (count < 0) {
+      if (errno == EINTR) continue;
+      return false;
+    }
+    cursor += count;
+    length -= (size_t)count;
+  }
